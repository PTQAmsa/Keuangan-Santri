# Contoh pengaturan produksi: hosting PHP biasa + database Supabase (PostgreSQL).
# Salin menjadi .env di server, lalu isi nilai yang bertanda <...>.

APP_NAME="Keuangan PTQ Amsa001"
APP_ENV=production
APP_KEY=<salin APP_KEY dari .env laptop agar PIN/sandi tersimpan tetap terbaca>
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_DEMO_MODE=false

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Supabase: Project Settings > Database > Connection string > Session pooler (IPv4).
# Gunakan port 5432 (session mode), bukan 6543, karena Laravel memakai prepared statement.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<ref-proyek-supabase>
DB_PASSWORD=<kata sandi database Supabase>
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hosting biasa tidak punya queue worker; pesan WhatsApp dikirim langsung saat transaksi.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# WhatsApp Gateway. Biarkan false sampai token Fonnte siap.
WHATSAPP_ENABLED=false
WHATSAPP_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_TOKEN=
WHATSAPP_COUNTRY_CODE=62

# Kontak WhatsApp bendahara untuk tombol "Hubungi Bendahara" (Nama:nomor;Nama:nomor).
TREASURER_CONTACTS="<Nama Bendahara 1>:<08xxxxxxxxxx>;<Nama Bendahara 2>:<08xxxxxxxxxx>"
